# 부하 테스트(perf) 전용 환경 변수. `cp .env.perf.example .env.perf` 후 채운다. .env.perf는 커밋하지 않는다.
# 운영 secret(JWT_SECRET, INTERNAL_API_TOKEN, TOKEN_ENCRYPTION_KEY)은 절대 재사용하지 않는다. 운영과 공유하는 값은 REDIS_PASSWORD 하나.

# ── 이미지 ────────────────────────────────────────────────────
# 운영에서 지금 돌고 있는 태그: docker inspect -f '{{.Config.Image}}' be-server-<blue|green>
PERF_IMAGE_TAG=

# ── DB (운영 PG 컨테이너 안 별도 database, seed/init-perf-db.sql로 생성) ──
DB_USERNAME=perf
DB_PASSWORD=

# ── Redis (운영 Redis 컨테이너, DB 15번만 사용) ────────────────────
REDIS_PASSWORD=

# ── perf 전용 secret (각각 새로 생성) ───────────────────────────
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 48
INTERNAL_API_TOKEN=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── 외부 연동 (부하 테스트에서 호출하지 않으므로 기동용 더미 값) ─────────
KAKAO_CLIENT_ID=perf-dummy
KAKAO_CLIENT_SECRET=perf-dummy
KAKAO_ADMIN_KEY=perf-dummy
NAVER_CLIENT_ID=perf-dummy
NAVER_CLIENT_SECRET=perf-dummy
GOOGLE_CLIENT_ID=perf-dummy
GOOGLE_CLIENT_SECRET=perf-dummy
# presigned-url은 기본 시나리오에서 제외. 운영 버킷 이름을 넣지 않는다(orphan 정리가 이 버킷에 delete를 보냄).
S3_BUCKET_NAME=perf-dummy-bucket
AWS_REGION=ap-northeast-2
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_REDIRECT_URIS=http://localhost:5173/oauth/callback

# ── Mock AI ──────────────────────────────────────────────────
# 상품 1개 처리 시간(초). 실제 AI는 1~2분. smoke 확인 때만 5/10처럼 줄인다.
MOCK_DURATION_MIN_S=60
MOCK_DURATION_MAX_S=120
# 202를 보낸 뒤 첫 콜백까지 지연(ms). BE가 runId를 저장하기 전에 콜백이 가면 409 COMMON-009
MOCK_FIRST_CALLBACK_DELAY_MS=500
# 접수 응답 지연(ms). 5000 이상이면 BE read timeout(5s) 경로
MOCK_ACCEPT_LATENCY_MS=0
# 질문(awaiting_input)으로 끝나는 비율, 실패로 끝나는 비율, 429로 거절하는 비율
MOCK_QUESTION_RATIO=0.2
MOCK_FAIL_RATIO=0
MOCK_429_RATIO=0
