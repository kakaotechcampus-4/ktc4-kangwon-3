        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "대기 · 실행 시간",
      "description": "대기: 접수부터 실행 시작까지, 실행: 시작부터 결말까지 (30m 창)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ai_session_queue_wait_seconds_bucket{run_type=~\"$run_type\"}[30m])))",
          "legendFormat": "대기 p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_session_queue_wait_seconds_bucket{run_type=~\"$run_type\"}[30m])))",
          "legendFormat": "대기 p95",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ai_session_run_seconds_bucket{run_type=~\"$run_type\"}[30m])))",
          "legendFormat": "실행 p50",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_session_run_seconds_bucket{run_type=~\"$run_type\"}[30m])))",
          "legendFormat": "실행 p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "단계별 시간 p95",
      "description": "Tool 재실행 회차의 같은 단계는 따로 셈 (30m 창)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
