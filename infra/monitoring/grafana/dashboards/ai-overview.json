      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(ai_session_slots_used{scope=\"all\"}) / sum(ai_session_slots_limit{scope=\"all\"})",
          "legendFormat": "",
          "range": true
