        "type": "query",
        "name": "run_type",
        "label": "실행 종류",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ai_session_accepted_total, run_type)",
          "refId": "run_type"
        },
        "definition": "label_values(ai_session_accepted_total, run_type)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "production"
          ],
          "value": [
            "production"
          ]
        },
        "sort": 1
      }
    ]
  },
