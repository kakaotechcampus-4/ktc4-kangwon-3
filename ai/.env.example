# ─────────────────────────────────────────────────────────────
#  외부 API 클라이언트 환경변수
#    .env 는 .gitignore 에 등록되어 커밋되지 않습니다.
#
#  필요한 키: DATA_GO_KR_KEY, LAW_GO_KR_OC (2개)
#    두 키 모두 필수입니다. 하나라도 비어 있으면 서버가 뜨지 않습니다.
#  선택 키: KEY_SAFETYKOREA. KC 인증 조회를 쓰는 Tool이 없어 비워 둬도 됩니다.
#  키 없이 동작: 관세청 CLIP, 국립전파연구원
#
#  새 환경변수 추가 위치
#    docker-compose.yml이 .env 전체를 컨테이너에 넣음(env_file) → 이 파일에만 추가
#    운영 서버는 ~/ai-app/.env에도 추가 (배포마다 이 파일을 복사, 필수값이 없으면 기동 실패)
# ─────────────────────────────────────────────────────────────


# ═══ 공공데이터포털 (data.go.kr) ═════════════════════════════
#   계정당 키 1개. API마다 「활용신청」하면 이 키에 권한이 붙음.
#   반드시 「일반 인증키(Encoding)」 (...%2B...%2F...%3D 형태).
#   마이페이지 → 개발계정 → 일반 인증키(Encoding)
#
#   ── 관세청 (CustomsGwClient) ──
#     get_confirmation()  — 세관장확인대상물품 조회
#
#   ── 식약처 (FdaClient) ──
#     get_medical_devices()        — 의료기기 품목정보 조회
#     get_cosmetics_regulations()  — 화장품 규제원료 조회
DATA_GO_KR_KEY=


# ═══ 국가기술표준원 제품안전정보센터 (safetykorea.kr) ═════════
#   자체 발급 (HWP 신청서). 헤더 AuthKey (대소문자 구분).
#   신청: safetykorea.kr/release/openapi
#   ⚠️ 배포 시 서버 IP 등록 필요 (4001 Invalid IP).
#   (선택) 쓰는 Tool이 없어 비워 두면 꺼짐.
#
#   ── SafetyKoreaClient ──
#     search_certifications()      — KC인증정보 조회
#     get_certification_detail()   — KC인증정보 상세
#     search_recalls()             — 국내리콜 조회
#     get_recall_detail()          — 국내리콜 상세
#     search_foreign_recalls()     — 국외리콜 조회
KEY_SAFETYKOREA=


# ═══ 법제처 국가법령정보 ════════════════════════════════════
#   키가 아니라 OC 값 (이메일 ID의 @ 앞부분).
#   발급: open.law.go.kr/LSO/openApi/cufeRgs.do (무료, 1~2영업일)
#
#   ── LawClient ──
#     search_law() / search_admrul() / search_eflaw() / search_licbyl()
#       — 법령 · 행정규칙 · 시행법령 · 자치법규 검색
#     get_law_text() / get_admrul_text() / get_eflaw_text() / get_licbyl_text()
#       — 법령 · 행정규칙 · 시행법령 · 자치법규 본문 조회
LAW_GO_KR_OC=test


# ═══ 키 불필요 ═══════════════════════════════════════════════
#   아래 클라이언트는 환경변수 없이 바로 동작합니다.
#
#   ── CLIPClient ──
#     search()  — 관세청 CLIP 품목분류 결정사례 조회
#
#   ── RadioClient ──
#     get_auth_info()    — 국립전파연구원 인증정보 조회
#     get_auth_status()  — 국립전파연구원 유효여부 조회
#     ⚠️ 브라우저 User-Agent 필수 (클라이언트가 자동 설정)


# ═══ AI 서버 ═════════════════════════════════════════════════
#   OPENAI_* 세 개 모두 필수입니다. 게이트웨이 하나로 OpenAI·Gemini·Claude 모델을 모두 부릅니다.
#   채팅 모델은 환경변수가 아니라 app/config/profiles.py의 프로필로 고릅니다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api-cloud-function.elice.io/v1
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
# (선택) 코드 기본값(app/config/profiles.py) 대신 쓸 모델 프로필. 벤치마크·긴급 전환용, 평소엔 비워 둠
# 형식: 종류.이름=프로필 을 쉼표로. 적은 대상만 바뀜. 예) agent.extraction=luna-low,tool.electrical_safety=luna-low
# 프로필: mini, luna-low, luna-medium, terra-low, terra-medium, haiku. 형식이 틀리거나 없는 이름이면 서버가 뜨지 않음
MODEL_PROFILE_OVERRIDES=

# ── AI 전용 PostgreSQL (pgvector) ────────────────────────────────
# BE PostgreSQL과 별도 컨테이너로 운영한다 (포트 5433).
# DATABASE_URL은 개발 단계에서는 선택이다. 비어 있으면 DB 기능 없이 서버가 뜬다.
# 값을 넣었다면 postgresql로 시작하는 접속 문자열이어야 한다(아니면 서버가 뜨지 않음).
DATABASE_URL=postgresql+psycopg://ai:ai@ai-db:5432/ai
AI_DB_NAME=ai
AI_DB_USERNAME=ai
AI_DB_PASSWORD=ai

# ── BE 내부 API 호출 (진단 콜백) ─────────────────────────────────
# 두 값 모두 필수. 비어 있으면 서버가 뜨지 않음
# BE_BASE_URL 운영 : compose 기본값 http://be-server:8080
# BE_BASE_URL 로컬 : 주석을 풀어 https://palgijeone.com 로 요청
#   (운영 BE의 /internal/**은 nginx가 외부에 열지 않아 로컬 AI의 콜백은 닿지 않음)
# BE_BASE_URL=https://palgijeone.com
# BE와 같은 값, 32자 이상. 콜백 X-Internal-Token 헤더로 보냄
INTERNAL_API_TOKEN=

# ── 샌드박스 진단 엔드포인트 (선택) ───────────────────────────────
# /api/ai/v1/sandbox/** : BE 없이 진단을 접수하고 상태 조회로 결과 확인 (콜백 없음)
# 켜면(true) 키 필수, 32자 이상, INTERNAL_API_TOKEN과 다른 값. 요청 헤더 X-Dev-Api-Key로 보냄
# 외부에서 부를 수 있는 진단이라 키는 필요한 사람에게만 공유 (생성 예: openssl rand -hex 24)
AI_DEV_API_ENABLED=false
AI_DEV_API_KEY=

# ── 입력 가드 문턱값 (필수) ───────────────────────────────────────
# 0~1 숫자, 0 < LOW < HIGH ≤ 1. 비어 있거나 범위를 벗어나면 서버가 뜨지 않음
# 값은 저장소에 적지 않음 → 팀에서 공유받아 채움
REVIEW_TEXT_HIGH=
REVIEW_TEXT_LOW=
REVIEW_IMAGE_HIGH=
REVIEW_IMAGE_LOW=

# ── 세션 상한·보관 시간 (선택) ────────────────────────────────────
# 1 이상의 정수. 비우면 괄호 안 기본값 (app/config/session.py). 바꾸면 서버를 다시 띄워야 반영됨
# 동시 실행 ≤ 대기 + 실행 상한, 샌드박스 상한 ≤ 대기 + 실행 상한이 아니면 서버가 뜨지 않음
# 동시에 실행하는 진단 수 (10). 넘는 세션은 대기
MAX_RUNNING_SESSIONS=
# 대기 + 실행 중 세션 상한 (20). 넘으면 접수 거절 → BE가 대기로 돌렸다가 재요청. 대기 세션당 메모리 약 5MB
MAX_INFLIGHT_SESSIONS=
# 샌드박스 진단 대기 + 실행 중 상한 (3). 샌드박스 요청 상품 수 상한도 이 값
MAX_DEV_INFLIGHT_SESSIONS=
# 진단 하나에서 동시에 실행하는 Tool 수 (6). 1이면 순차. 동시 모델 호출은 최대 MAX_RUNNING_SESSIONS × 이 값
MAX_PARALLEL_TOOLS=
# 끝난 세션 보관 시간, 초 (3600)
SESSION_RETENTION_SECONDS=
# 답변 대기 세션 보관 시간, 초 (86400). 지나면 재진단 요청은 404
AWAITING_INPUT_RETENTION_SECONDS=

# ── 로그 (선택) ─────────────────────────────────────────────────
# 앱 로그 레벨: DEBUG / INFO / WARNING / ERROR. 비우면 INFO
LOG_LEVEL=

# ── Sentry (선택) ───────────────────────────────────────────────
# 오류 전송. 비우면 끔. 넣으면 환경 이름 필수 (서버 prod, BE Spring 프로필과 같게)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Sentry로 보낼 로그 레벨: INFO / WARNING / ERROR / OFF. 비우면 INFO, OFF면 오류 이벤트만
SENTRY_LOG_LEVEL=

# ── LangSmith (선택) ───────────────────────────────────────────
# 진단의 모델 호출을 LangSmith 화면에 기록. 프롬프트·상품 문구·모델 응답이 LangSmith로 전송됨
# 사용법은 docs/current/observability/AI_TRACE.md 6절
# 기록 여부: true / false. 비우면 false
LANGSMITH_TRACING=
# LangSmith 설정 화면에서 발급한 API 키
LANGSMITH_API_KEY=
# 기록을 모을 프로젝트 이름. 예: 로컬 ktc4-local, 서버 ktc4-prod. 비우면 default
LANGSMITH_PROJECT=
