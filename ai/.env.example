# AI 파트 로컬 개발용 환경 변수 예시 파일입니다.
# `cp .env.example .env` 후 값을 채워주세요. `.env`는 git에 커밋되지 않습니다.
# 코드에서는 python-dotenv로 로드합니다: from dotenv import load_dotenv; load_dotenv()

# ── LLM (추출·선택·검증 에이전트 공용) ───────────────────────────
# 2026-09-03 결정: Gemini 3.5 Flash → GPT-4.1-mini로 통일 (1단계에서 쓰던 모델과 동일).
#
# ⚠️ OpenAI 공식 API(platform.openai.com)가 아니라 카카오테크캠퍼스가 제공하는
# 엘리스 AI클라우드 MLAPI(Serverless)를 통해 호출한다. 콘솔: kakaotechcampus.elice.io
# → AI Cloud → ML API → API 키 관리 → Serverless 키 발급.
# base_url을 안 채우고 기본 OpenAI 서버로 보내면 401 invalid_issuer 에러가 난다
# (캠퍼스가 발급한 키를 OpenAI 서버가 자기 키가 아니라고 거절하는 것).
OPENAI_API_KEY=
# 채팅용 실제 Base URL은 로컬 ai/.env 또는 배포 환경변수에 설정합니다.
OPENAI_BASE_URL=
# 카탈로그 등록명 그대로 "openai/" 접두어 포함해서 써야 한다.
OPENAI_MODEL=openai/gpt-4.1-mini

# ── (참고, 지금 당장 필요하지 않음) 소관 API 연동 시 필요 ──────────
# 아래는 tools/* 구현(선택 에이전트 담당) 단계에서 필요해지는 키다.
# 추출 에이전트 개발에는 필요 없으므로 지금은 값을 안 채워도 된다.
#
# 관세청 CLIP 품목분류 결정사례(1-1-1)      : 키 불필요
# 관세청 세관장확인대상물품(1-1-2)          : data.go.kr 일반 인증키
# CUSTOMS_SERVICE_KEY=
# 법제처 국가법령정보 API(1-2)             : 인증키 아님, 등록 이메일 앞부분(OC)
# LAW_OC=
# 식약처 의료기기/화장품 API(1-5)          : data.go.kr 일반 인증키 (API별 별도 발급)
# FOOD_DRUG_SERVICE_KEY=
# 국립전파연구원 적합성평가 조회(1-4)       : 키 불필요, 단 User-Agent 헤더 필수
# 국가기술표준원 KC 인증번호 조회(1-3)      : 키 불필요
