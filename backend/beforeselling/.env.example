# 로컬 개발용 환경 변수 예시 파일입니다.
# `cp .env.example .env` 후 값을 채워주세요. `.env`는 git에 커밋되지 않습니다.
# 앱 실행 시 로드 방법: IntelliJ EnvFile 플러그인 또는 `set -a; source .env; set +a; ./gradlew bootRun`
# docker compose는 같은 디렉토리의 .env를 자동으로 읽습니다.

# ── Database ─────────────────────────────────────────────────
DB_NAME=beforeselling
DB_USERNAME=beforeselling
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/beforeselling

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────────
# HS256 서명 키. 32바이트(256비트) 이상 필수. 생성 예: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=14d

# ── OAuth2 소셜 로그인 ───────────────────────────────────────
# 각 제공자 콘솔에 Redirect URI를 등록해야 합니다.
#   http://localhost:8080/login/oauth2/code/kakao
#   http://localhost:8080/login/oauth2/code/naver
#   http://localhost:8080/login/oauth2/code/google
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Frontend / Cookie ────────────────────────────────────────
# 소셜 로그인 성공/실패 후 리다이렉트할 프론트엔드 콜백 URL
FRONTEND_REDIRECT_URI=http://localhost:5173/oauth/callback
# CORS 허용 origin (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Refresh Token 쿠키 속성. 운영(HTTPS)에서는 COOKIE_SECURE=true.
# 프론트/백엔드 도메인이 다른 사이트면 COOKIE_SAME_SITE=None (Secure=true 필수)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
